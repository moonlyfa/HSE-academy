# هر ده دقیقه. تراکنشی که پاسخ تأییدش در شبکه گم شده، حداکثر ده دقیقه
# بعد دوباره پرسیده می‌شود و دسترسی مشتری باز می‌شود.
#
#     systemctl list-timers hse-verify-payments.timer
#     journalctl -u hse-verify-payments.service -n 30

[Unit]
Description=Re-verify pending HSE Academy payments every 10 minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=10min
Persistent=true

[Install]
WantedBy=timers.target

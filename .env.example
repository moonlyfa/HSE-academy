# =============================================================================
#  نمونه فایل تنظیمات محیطی — آکادمی HSE
# -----------------------------------------------------------------------------
#  این فایل «الگو» است و در گیت ذخیره می‌شود؛ اینجا هیچ مقدار واقعی و حساسی
#  ننویسید. برای اجرای پروژه یک کپی از آن با نام .env بسازید و مقادیر را پر کنید.
#
#  Windows :  copy .env.example .env
#  Linux/macOS :  cp .env.example .env
# =============================================================================

# --- پایه ---
# کلید رمزنگاری Django. برای Production حتماً یک مقدار تصادفی جدید بسازید:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=dev-only-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# آدرس پنل مدیریت. در Production آن را عوض کنید (مثلاً: hse-panel-2f9x)
DJANGO_ADMIN_URL=admin

# --- دیتابیس ---
# در توسعه اگر این خط را خالی/کامنت بگذارید، به‌صورت خودکار از SQLite استفاده می‌شود.
# نمونه Production:
# DATABASE_URL=postgres://hse_user:STRONG_PASSWORD@127.0.0.1:5432/hse_db
# DATABASE_URL=

# --- اطلاعات سایت ---
SITE_NAME=آکادمی HSE
SITE_DOMAIN=127.0.0.1:8000
SITE_SUPPORT_PHONE=021-00000000
SITE_SUPPORT_EMAIL=info@example.com

# --- سرویس‌های خارجی (در توسعه همه Mock هستند) ---
# با True بودن این‌ها، بدون خرید هیچ API می‌توانید کل جریان سایت را تست کنید.
USE_MOCK_SMS=True
USE_MOCK_IDENTITY=True
USE_MOCK_PAYMENT=True

# --- بخش مقالات و اخبار (در نسخه اول منتشر نمی‌شود) ---
BLOG_ENABLED=False

# =============================================================================
#  مقادیر زیر در فازهای بعدی استفاده می‌شوند. فعلاً خالی بمانند.
# =============================================================================

# --- پنل پیامک ---
# در توسعه USE_MOCK_SMS=True است و کد در ترمینال چاپ می‌شود.
# وقتی پنل واقعی خریدید: USE_MOCK_SMS=False و مقادیر زیر را پر کنید.
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_NUMBER=
SMS_OTP_TEMPLATE=
SMS_TIMEOUT_SECONDS=10

# --- تنظیمات کد یکبارمصرف ---
OTP_CODE_LENGTH=6
OTP_EXPIRY_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=90
OTP_MAX_SENDS_PER_HOUR=5

# --- سرویس تطبیق موبایل و کد ملی ---
# در توسعه USE_MOCK_IDENTITY=True است و نتیجه با MOCK_IDENTITY_RESULT کنترل می‌شود:
#   matched          = همیشه تطبیق دارد (پیش‌فرض)
#   not_matched      = همیشه تطبیق ندارد
#   failed           = همیشه خطای سرویس
#   by_national_code = ختم به ۰۰ تطبیق ندارد، ختم به ۹۹ خطا
MOCK_IDENTITY_RESULT=matched
IDENTITY_PROVIDER=mock
IDENTITY_API_BASE_URL=
IDENTITY_API_KEY=
IDENTITY_API_TIMEOUT=10

# اگر False شود، کاربر بدون احراز هویت هم می‌تواند ثبت‌نام کند
# اما تا تکمیل احراز هویت، گواهی برایش صادر نمی‌شود.
IDENTITY_REQUIRED_FOR_REGISTRATION=True

# --- درگاه پرداخت زرین‌پال (فاز ۱۳) ---
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True
ZARINPAL_CALLBACK_URL=http://127.0.0.1:8000/payments/callback/

# --- اسکای‌روم (فاز ۱۵) ---
SKYROOM_API_KEY=

# --- ایمیل (Production) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- امنیت در Production ---
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.ir
# DJANGO_SECURE_SSL_REDIRECT=True

# پایان خط فایل‌ها را گیت خودش تنظیم می‌کند.
* text=auto

# فایل‌های ویندوزی باید CRLF بمانند؛ با LF، بعضی نسخه‌های cmd خط آخر
# دستورها را اشتباه می‌خوانند.
*.bat text eol=crlf
*.cmd text eol=crlf

# اسکریپت‌های شل و پیکربندی سرور همیشه LF، حتی اگر روی ویندوز ویرایش شوند.
*.sh text eol=lf
deploy/* text eol=lf

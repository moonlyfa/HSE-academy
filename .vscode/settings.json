{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true
    },
    "[python]": {
        "editor.rulers": [100],
        "editor.tabSize": 4
    },
    "[html]": {
        "editor.tabSize": 4
    },
    "emmet.includeLanguages": {
        "django-html": "html"
    },
    "files.associations": {
        "**/templates/**/*.html": "django-html"
    }
}
